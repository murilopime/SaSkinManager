<Window x:Class="SaSkinManager.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SA Skin Manager — configuração" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <StackPanel Margin="28">
        <TextBlock Text="Bem-vindo ao SA Skin Manager" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,20" TextWrapping="Wrap" FontSize="13"
                   Text="Escolha a pasta do GTA San Andreas (onde fica o gta_sa.exe). O programa lê a lista de personagens e as texturas do jogo para mostrar todos os NPCs."/>

        <StackPanel x:Name="SetupPanel">
            <TextBlock Text="Pasta do jogo" Margin="0,0,0,6"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Procurar…" Click="Browse_Click" Margin="6,0,0,0"/>
                <TextBox x:Name="PathBox" TextChanged="PathBox_TextChanged"/>
            </DockPanel>
            <TextBlock x:Name="ValidationText" Margin="0,6,0,0" FontSize="12"/>

            <TextBlock x:Name="DetectedHeader" Text="Encontrado automaticamente:" Style="{StaticResource Dim}" Margin="0,14,0,4" Visibility="Collapsed"/>
            <ItemsControl x:Name="DetectedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" HorizontalContentAlignment="Left" Click="Detected_Click" Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox x:Name="ScanNowBox" IsChecked="True" Margin="0,18,0,0">
                <TextBlock Text="Carregar todos os modelos de NPC agora (gera as miniaturas, recomendado)" TextWrapping="Wrap"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Click="Cancel_Click"/>
                <Button x:Name="ContinueButton" Content="Continuar" Style="{StaticResource Primary}" Click="Continue_Click" IsEnabled="False" Margin="0,0,0,6"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ScanPanel" Visibility="Collapsed">
            <TextBlock Text="Carregando personagens…" FontSize="15" FontWeight="SemiBold"/>
            <ProgressBar x:Name="Progress" Margin="0,12,0,8" Maximum="1"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Dim}"/>
        </StackPanel>
    </StackPanel>
</Window>
