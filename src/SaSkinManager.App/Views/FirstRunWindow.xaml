<Window x:Class="SaSkinManager.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SaSkinManager.App.Services"
        Title="{s:Tr Pt='SA Skin Manager — configuração', En='SA Skin Manager — setup'}" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <StackPanel Margin="28">
        <DockPanel>
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="170" VerticalAlignment="Top" DisplayMemberPath="Label"
                      SelectionChanged="Language_Changed"/>
            <TextBlock Text="{s:Tr Pt='Bem-vindo ao SA Skin Manager', En='Welcome to SA Skin Manager'}" FontSize="22" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,20" TextWrapping="Wrap" FontSize="13"
                   Text="{s:Tr Pt='Escolha a pasta do GTA San Andreas (onde fica o gta_sa.exe). O programa lê a lista de personagens e as texturas do jogo para mostrar todos os NPCs.', En='Choose the GTA San Andreas folder (where gta_sa.exe is). The program reads the character list and the game textures to show every NPC.'}"/>

        <StackPanel x:Name="SetupPanel">
            <TextBlock Text="{s:Tr Pt='Pasta do jogo', En='Game folder'}" Margin="0,0,0,6"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{s:Tr Pt='Procurar…', En='Browse…'}" Click="Browse_Click" Margin="6,0,0,0"/>
                <TextBox x:Name="PathBox" TextChanged="PathBox_TextChanged"/>
            </DockPanel>
            <TextBlock x:Name="ValidationText" Margin="0,6,0,0" FontSize="12"/>

            <TextBlock x:Name="DetectedHeader" Text="{s:Tr Pt='Encontrado automaticamente:', En='Found automatically:'}" Style="{StaticResource Dim}" Margin="0,14,0,4" Visibility="Collapsed"/>
            <ItemsControl x:Name="DetectedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" HorizontalContentAlignment="Left" Click="Detected_Click" Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox x:Name="ScanNowBox" IsChecked="True" Margin="0,18,0,0">
                <TextBlock TextWrapping="Wrap"
                           Text="{s:Tr Pt='Carregar todos os modelos de NPC agora (gera as miniaturas, recomendado)', En='Load every NPC model now (creates the thumbnails, recommended)'}"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{s:Tr Pt='Cancelar', En='Cancel'}" Click="Cancel_Click"/>
                <Button x:Name="ContinueButton" Content="{s:Tr Pt='Continuar', En='Continue'}" Style="{StaticResource Primary}" Click="Continue_Click" IsEnabled="False" Margin="0,0,0,6"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ScanPanel" Visibility="Collapsed">
            <TextBlock Text="{s:Tr Pt='Carregando personagens…', En='Loading characters…'}" FontSize="15" FontWeight="SemiBold"/>
            <ProgressBar x:Name="Progress" Margin="0,12,0,8" Maximum="1"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Dim}"/>
        </StackPanel>
    </StackPanel>
</Window>
