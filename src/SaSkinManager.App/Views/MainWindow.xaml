<Window x:Class="SaSkinManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SaSkinManager.App.Services"
        Title="SA Skin Manager" Width="1360" Height="840" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <!-- Bloco da grade de personagens: com o mouse em cima, o modelo 3D aparece girando. -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <EventSetter Event="MouseEnter" Handler="Tile_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Tile_MouseLeave"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="{StaticResource PanelAlt}" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="8" Padding="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentDim}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ToggleSeg" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10,10,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{s:Tr Pt='Abrir pasta do jogo', En='Open game folder'}" Command="{Binding OpenGameFolderCommand}"/>
                    <Button Content="{s:Tr Pt='Reescanear', En='Rescan'}" Command="{Binding RescanCommand}"/>
                    <Button Content="{s:Tr Pt='⚙  Configurações', En='⚙  Settings'}" Click="Settings_Click"/>
                    <Button Content="{s:Tr Pt='▶  Jogar', En='▶  Play'}" Style="{StaticResource Primary}" Command="{Binding PlayCommand}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run Text="SA Skin Manager"/>
                        <Run Text="  ·  " Foreground="{StaticResource FgDim}"/>
                        <Run Text="{Binding ModeBadge, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding GamePath}" Style="{StaticResource Dim}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360"/>
                <ColumnDefinition Width="4*" MinWidth="420"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Personagens -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="▦" Command="{Binding ShowGridCommand}" ToolTip="{s:Tr Pt='Ver em grade', En='Grid view'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleSeg}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GridView}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="☰" Command="{Binding ShowListCommand}" ToolTip="{s:Tr Pt='Ver em lista', En='List view'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleSeg}">
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ListView}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource H2}">
                        <Run Text="{s:Tr Pt='Personagens', En='Characters'}"/>
                        <Run Text="{Binding VisibleCount, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource FgDim}"/>
                    </TextBlock>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="{s:Tr Pt='Buscar por nome, modelo (ex.: bmybar) ou ID · Ctrl+F', En='Search by name, model (e.g. bmybar) or ID · Ctrl+F'}"/>
                        <TextBlock Text="{s:Tr Pt='🔍 Buscar…', En='🔍 Search…'}" Margin="9,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"/>
                </Grid>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="{s:Tr Pt='Todos', En='All'}" Command="{Binding SetFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterIsAll}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{s:Tr Pt='Trocados', En='Swapped'}" Command="{Binding SetFilterCommand}" CommandParameter="Swapped">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterIsSwapped}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{s:Tr Pt='Não trocados', En='Not swapped'}" Command="{Binding SetFilterCommand}" CommandParameter="NotSwapped">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterIsNotSwapped}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{s:Tr Pt='★ Favoritos', En='★ Favorites'}" Command="{Binding SetFilterCommand}" CommandParameter="Favorites">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterIsFavorites}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                </WrapPanel>

                <Grid>
                    <!-- Grade -->
                    <ListBox x:Name="PedGrid" ItemsSource="{Binding PedsView}" SelectedItem="{Binding SelectedPed}" ItemContainerStyle="{StaticResource TileItem}"
                             ScrollViewer.ScrollChanged="PedGrid_ScrollChanged" IsVisibleChanged="PedGrid_IsVisibleChanged"
                             Visibility="{Binding GridView, Converter={StaticResource BoolToVis}}" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Extended" SelectionChanged="Peds_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{s:Tr Pt='★ Favoritar / tirar dos favoritos', En='★ Favorite / unfavorite'}"
                                          Command="{Binding ToggleFavoriteCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="{Binding DataContext.ThumbSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <StackPanel.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9AA0AA"/>
                                            <TextBlock Text="{Binding SwapText}" Foreground="{DynamicResource Accent}"/>
                                        </StackPanel>
                                    </StackPanel.ToolTip>
                                    <Grid Height="{Binding DataContext.ThumbSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Border CornerRadius="6" Background="{StaticResource Panel}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource FgDim}" FontSize="26"/>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Background="{StaticResource Panel}" Visibility="{Binding LiveModel, Converter={StaticResource NullToVis}}">
                                                    <s:ModelViewer Model="{Binding LiveModel}" Interactive="False" Speed="60"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="★" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" FontSize="16"
                                                   Foreground="#FFD54A" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" CornerRadius="9" MinWidth="18" Height="18"
                                                Background="{DynamicResource Accent}" Visibility="{Binding IsSwapped, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓" Foreground="#1A1205" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Model.ModelName}" Style="{StaticResource Dim}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Lista -->
                    <ListBox ItemsSource="{Binding PedsView}" SelectedItem="{Binding SelectedPed}" VirtualizingPanel.IsVirtualizing="True"
                             Visibility="{Binding ListView, Converter={StaticResource BoolToVis}}"
                             SelectionMode="Extended" SelectionChanged="Peds_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{s:Tr Pt='★ Favoritar / tirar dos favoritos', En='★ Favorite / unfavorite'}"
                                          Command="{Binding ToggleFavoriteCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="4" Background="{StaticResource PanelAlt}" Margin="0,0,10,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" FontSize="18"/>
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Foreground="#FFD54A">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value=" ★"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}"/>
                                        <TextBlock Text="{Binding SwapText}" Foreground="{DynamicResource Accent}" FontSize="12"
                                                   Visibility="{Binding IsSwapped, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <!-- Detalhes / troca -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleFavoriteCommand}" Padding="10,4" Margin="0" VerticalAlignment="Center"
                                    ToolTip="{s:Tr Pt='Favoritar este personagem', En='Favorite this character'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{s:Tr Pt='☆ Favoritar', En='☆ Favorite'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPed.IsFavorite}" Value="True">
                                                <Setter Property="Content" Value="{s:Tr Pt='★ Favorito', En='★ Favorite'}"/>
                                                <Setter Property="Foreground" Value="#FFD54A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding SelectedPed.Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedPed.CategoryLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedPed.Description, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Prévia 3D: original × nova skin (arrastar gira, roda do mouse aproxima) -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{s:Tr Pt='ORIGINAL', En='ORIGINAL'}" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                                <Border Height="300" CornerRadius="6" Background="{StaticResource PanelAlt}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{s:Tr Pt='sem miniatura', En='no thumbnail'}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Dim}"
                                                   Visibility="{Binding SelectedPed.Thumb, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        <Image Source="{Binding SelectedPed.Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding OriginalModel, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        <s:ModelViewer Model="{Binding OriginalModel}" AutoRotate="{Binding AutoRotate}" SyncGroup="preview"
                                                       Visibility="{Binding OriginalModel, Converter={StaticResource NullToVis}}"
                                                       ToolTip="{s:Tr Pt='Arraste para girar · roda do mouse: zoom · clique duplo: voltar', En='Drag to rotate · mouse wheel: zoom · double-click: reset'}"/>
                                        <TextBlock Text="{s:Tr Pt='carregando 3D…', En='loading 3D…'}" Style="{StaticResource Dim}" FontSize="11" Margin="8,6"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding LoadingOriginal, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedPed.Files}" Style="{StaticResource Dim}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{s:Tr Pt='NOVA SKIN', En='NEW SKIN'}" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                                <Border Height="300" CornerRadius="6" Background="{StaticResource PanelAlt}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{s:Tr Pt='escolha uma skin na biblioteca →', En='pick a skin in the library →'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                                                   Visibility="{Binding SelectedSkin.Thumb, Converter={StaticResource NullToVis}, ConverterParameter=invert, FallbackValue=Visible}"/>
                                        <Image Source="{Binding SelectedSkin.Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding NewModel, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        <s:ModelViewer Model="{Binding NewModel}" AutoRotate="{Binding AutoRotate}" SyncGroup="preview"
                                                       Visibility="{Binding NewModel, Converter={StaticResource NullToVis}}"
                                                       ToolTip="{s:Tr Pt='Arraste para girar · roda do mouse: zoom · clique duplo: voltar', En='Drag to rotate · mouse wheel: zoom · double-click: reset'}"/>
                                        <TextBlock Text="{s:Tr Pt='carregando 3D…', En='loading 3D…'}" Style="{StaticResource Dim}" FontSize="11" Margin="8,6"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding LoadingNew, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedSkin.Title}" Margin="0,6,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,14,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource AccentDim}"
                                Visibility="{Binding SelectedPed.IsCj, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="{s:Tr Pt='CJ é especial: o corpo dele vem das peças de roupa do player.img. Use skins importadas como &quot;Pacote do CJ&quot; (torso, legs, feet, head…). Para virar outro personagem, use um mod como o Skin Selector (CLEO).', En='CJ is special: his body comes from the player.img clothing parts. Use skins imported as &quot;CJ pack&quot; (torso, legs, feet, head…). To become another character, use a mod such as Skin Selector (CLEO).'}"/>
                        </Border>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasLinked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{s:Tr Pt='Trocar também (cutscenes e variações de missão):', En='Also swap (cutscenes and mission variants):'}"
                                       Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Linked}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include}" Content="{Binding Label}" Margin="0,2,16,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource AccentDim}"
                                Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MultiText}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="{s:Tr Pt='Modo:', En='Mode:'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{s:Tr Pt='Trocar por esta skin', En='Swap to this skin'}" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" Padding="18,8"
                                    ToolTip="Enter"/>
                            <Button Content="{s:Tr Pt='Desfazer troca', En='Undo swap'}" Command="{Binding RevertSelectedCommand}" Padding="18,8"/>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Accent}" FontSize="12" Text="{Binding SelectedSwapText}"/>
                    </StackPanel>

                    <!-- Trocas ativas -->
                    <DockPanel Margin="0,14,0,0">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="{s:Tr Pt='Restaurar tudo', En='Restore all'}" Command="{Binding RevertAllCommand}" Margin="0"/>
                            <TextBlock Text="{s:Tr Pt='Trocas ativas', En='Active swaps'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SwapGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAlt}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Margin="0" Padding="10,3" Command="{Binding UndoCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Content" Value="{s:Tr Pt='Desfazer', En='Undo'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasMany}" Value="True">
                                                                        <Setter Property="Content" Value="{s:Tr Pt='Desfazer tudo', En='Undo all'}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button DockPanel.Dock="Left" Content="{Binding Arrow}" Command="{Binding ToggleCommand}"
                                                            Padding="6,1" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                            ToolTip="{s:Tr Pt='Mostrar os modelos', En='Show the models'}"
                                                            Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                                                        <Run Text=" → " Foreground="{DynamicResource Accent}"/>
                                                        <Run Text="{Binding SkinName, Mode=OneWay}"/>
                                                        <Run Text="{Binding ModeText, Mode=OneWay, StringFormat=  ({0})}" Foreground="{StaticResource FgDim}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Entries}" Margin="28,6,0,0"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <Button DockPanel.Dock="Right" Content="{s:Tr Pt='Desfazer', En='Undo'}" Margin="0" Padding="8,2" FontSize="12"
                                                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding Record}"/>
                                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12">
                                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                                    <Run Text="{Binding Model, Mode=OneWay, StringFormat=  ({0})}" Foreground="{StaticResource FgDim}"/>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Biblioteca -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="⋯" Padding="10,0" Margin="0,0,0,8" VerticalAlignment="Top" Click="LibraryMenu_Click"
                            ToolTip="{s:Tr Pt='Backup da biblioteca', En='Library backup'}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{s:Tr Pt='Exportar biblioteca (.zip)…', En='Export library (.zip)…'}" Command="{Binding ExportLibraryCommand}"/>
                                <MenuItem Header="{s:Tr Pt='Restaurar backup (.zip)…', En='Restore backup (.zip)…'}" Command="{Binding RestoreLibraryCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="{s:Tr Pt='Biblioteca de skins', En='Skin library'}" Style="{StaticResource H2}"/>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top">
                    <Button Content="{s:Tr Pt='+ Arquivos/.zip', En='+ Files/.zip'}" Command="{Binding ImportFilesCommand}"/>
                    <Button Content="{s:Tr Pt='+ Pasta', En='+ Folder'}" Command="{Binding ImportFolderCommand}"/>
                    <Button Content="{s:Tr Pt='+ Pacote do CJ', En='+ CJ pack'}" Command="{Binding ImportCjPackCommand}"/>
                </WrapPanel>
                <Grid DockPanel.Dock="Top" Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SkinSearchBox" Text="{Binding SkinSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        <TextBlock Text="{s:Tr Pt='🔍 Buscar skin…', En='🔍 Search skin…'}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SkinSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SkinSorts}" SelectedItem="{Binding SelectedSkinSort}" DisplayMemberPath="Label"
                              ToolTip="{s:Tr Pt='Ordenar', En='Sort'}"/>
                </Grid>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="{s:Tr Pt='Remover', En='Remove'}" Command="{Binding RemoveSkinCommand}" Margin="0"/>
                    <Button DockPanel.Dock="Right" Content="{s:Tr Pt='Renomear', En='Rename'}" Command="{Binding BeginRenameCommand}"
                            ToolTip="{s:Tr Pt='Renomear a skin (F2 ou clique duplo)', En='Rename the skin (F2 or double-click)'}"/>
                    <TextBlock Text="{s:Tr Pt='Arraste .dff, .txd, pastas ou .zip para cá', En='Drop .dff, .txd, folders or .zip here'}" Style="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ListBox x:Name="SkinList" ItemsSource="{Binding SkinsView}" SelectedItem="{Binding SelectedSkin}"
                         AllowDrop="True" Drop="SkinList_Drop" DragOver="SkinList_DragOver"
                         MouseDoubleClick="SkinList_DoubleClick" KeyDown="SkinList_KeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{s:Tr Pt='Renomear', En='Rename'}" InputGestureText="F2" Command="{Binding BeginRenameCommand}"/>
                            <MenuItem Header="{s:Tr Pt='Remover', En='Remove'}" Command="{Binding RemoveSkinCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="4" Background="{StaticResource PanelAlt}" Margin="0,0,10,0" ClipToBounds="True">
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" MaxLength="80"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UsageText}" Foreground="{DynamicResource Accent}" FontSize="11"
                                               Visibility="{Binding IsUsed, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Avisos (toasts) -->
            <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Width="380" Margin="0,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="t" Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="#2E3139"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}" Padding="6,1" Margin="6,0,0,0"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Top"/>
                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Padding="10,3" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock x:Name="icon" DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="t" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Barra de status -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ThumbProgress}" Style="{StaticResource Dim}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Overlay de carregamento -->
        <Grid Grid.RowSpan="3" Background="#CC101114" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Padding="24" CornerRadius="10" Background="{StaticResource Panel}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{s:Tr Pt='Carregando personagens…', En='Loading characters…'}" FontSize="16" FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding Progress}" Maximum="1" Margin="0,12,0,8"/>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Dim}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
