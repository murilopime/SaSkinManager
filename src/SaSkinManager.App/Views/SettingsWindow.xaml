<Window x:Class="SaSkinManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SaSkinManager.App.Services"
        Title="{s:Tr Pt='Configurações', En='Settings'}" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,18,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,14,26,24">
        <!-- Geral -->
        <TextBlock Text="{s:Tr Pt='Geral', En='General'}" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{s:Tr Pt='Idioma', En='Language'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Column="1" x:Name="LanguageBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{s:Tr Pt='Modo de instalação padrão', En='Default install mode'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ModeBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
        </Grid>
        <CheckBox x:Name="CloseOnPlayBox" Margin="0,12,0,0"
                  Content="{s:Tr Pt='Fechar o programa ao clicar em Jogar', En='Close the program when clicking Play'}"/>

        <!-- Aparência -->
        <TextBlock Text="{s:Tr Pt='Aparência', En='Appearance'}" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{s:Tr Pt='Cor de destaque', En='Accent color'}" Style="{StaticResource Label}"/>
            <!-- bolinhas de cor: muda na hora, "Cancelar" volta a anterior -->
            <ListBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="AccentBox" Background="Transparent" BorderThickness="0"
                     Margin="0,0,0,8" SelectionChanged="Accent_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                        <Setter Property="ToolTip" Value="{Binding Label}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <StackPanel Width="54">
                                        <Border x:Name="ring" Width="34" Height="34" CornerRadius="17" BorderThickness="2"
                                                BorderBrush="Transparent" HorizontalAlignment="Center">
                                            <Ellipse Width="24" Height="24" Fill="{Binding Swatch}"/>
                                        </Border>
                                        <TextBlock x:Name="label" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource FgDim}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Line}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Fg}"/>
                                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Fg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{s:Tr Pt='Mostrar personagens em', En='Show characters as'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ViewBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Text="{s:Tr Pt='Tamanho das miniaturas', En='Thumbnail size'}" Style="{StaticResource Label}"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="ThumbSlider" Minimum="72" Maximum="200" TickFrequency="8"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=ThumbSlider, StringFormat={}{0:0} px}"
                       Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8"/>
        </Grid>

        <CheckBox x:Name="ShowCutscenesBox" Margin="0,4,0,0"
                  Content="{s:Tr Pt='Mostrar as versões de cutscene na lista de personagens', En='Show cutscene versions in the character list'}"
                  ToolTip="{s:Tr Pt='Elas já são trocadas junto com o personagem. Também dá para vê-las pela categoria Cutscenes.', En='They are already swapped together with the character. You can also see them through the Cutscenes category.'}"/>

        <CheckBox x:Name="Preview3DBox" Margin="0,8,0,0"
                  Content="{s:Tr Pt='Prévia e miniaturas com o modelo 3D', En='3D model preview and thumbnails'}"
                  ToolTip="{s:Tr Pt='Desligado, mostra só a textura do personagem (mais leve).', En='When off, only the character texture is shown (lighter).'}"/>
        <CheckBox x:Name="AutoRotateBox" Margin="0,8,0,0"
                  Content="{s:Tr Pt='Girar os modelos 3D sozinhos', En='Rotate 3D models automatically'}"
                  IsEnabled="{Binding IsChecked, ElementName=Preview3DBox}"/>
        <CheckBox x:Name="SpinGridBox" Margin="0,8,0,0"
                  Content="{s:Tr Pt='Girar todos os personagens da grade (desligado: só o que está sob o mouse)', En='Rotate every character in the grid (off: only the one under the mouse)'}"
                  IsEnabled="{Binding IsChecked, ElementName=Preview3DBox}"/>

        <CheckBox x:Name="AdultBox" Margin="0,8,0,0" Checked="AdultBox_Checked"
                  Content="{s:Tr Pt='Modo 18+ (mostra as versões Hot Coffee das namoradas do CJ)', En='18+ mode (shows the Hot Coffee versions of the girlfriends of CJ)'}"
                  ToolTip="{s:Tr Pt='Desligado: as versões 1 e 2 das namoradas (gangrl, mecgrl, copgrl, nurgrl, crogrl, gungrl) ficam escondidas. A versão 3, a normal, sempre aparece.', En='Off: girlfriend versions 1 and 2 (gangrl, mecgrl, copgrl, nurgrl, crogrl, gungrl) are hidden. Version 3, the regular one, is always shown.'}"/>

        <!-- Jogo -->
        <TextBlock Text="{s:Tr Pt='Jogo', En='Game'}" Style="{StaticResource Section}"/>
        <TextBlock x:Name="GamePathText" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <WrapPanel>
            <Button Content="{s:Tr Pt='Trocar pasta do jogo…', En='Change game folder…'}" Click="ChangeFolder_Click"/>
            <Button Content="{s:Tr Pt='Limpar cache e reescanear', En='Clear cache and rescan'}" Click="Rescan_Click"/>
            <Button Content="{s:Tr Pt='Abrir pasta de dados', En='Open data folder'}" Click="OpenData_Click"/>
        </WrapPanel>

        <!-- Sobre -->
        <TextBlock Text="{s:Tr Pt='Sobre', En='About'}" Style="{StaticResource Section}"/>
        <TextBlock x:Name="AboutText" Style="{StaticResource Dim}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{s:Tr Pt='Cancelar', En='Cancel'}" IsCancel="True"/>
            <Button Content="{s:Tr Pt='Salvar', En='Save'}" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" Margin="0,0,0,6"/>
        </StackPanel>
    </StackPanel>
</Window>
