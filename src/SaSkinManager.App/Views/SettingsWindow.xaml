<Window x:Class="SaSkinManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SaSkinManager.App.Services"
        Title="{s:Tr Pt='Configurações', En='Settings'}" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,18,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="26,14,26,24">
        <!-- Geral -->
        <TextBlock Text="{s:Tr Pt='Geral', En='General'}" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{s:Tr Pt='Idioma', En='Language'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Column="1" x:Name="LanguageBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{s:Tr Pt='Modo de instalação padrão', En='Default install mode'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ModeBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
        </Grid>
        <CheckBox x:Name="CloseOnPlayBox" Margin="0,12,0,0"
                  Content="{s:Tr Pt='Fechar o programa ao clicar em Jogar', En='Close the program when clicking Play'}"/>

        <!-- Aparência -->
        <TextBlock Text="{s:Tr Pt='Aparência', En='Appearance'}" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{s:Tr Pt='Mostrar personagens em', En='Show characters as'}" Style="{StaticResource Label}"/>
            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="ViewBox" DisplayMemberPath="Label" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{s:Tr Pt='Tamanho das miniaturas', En='Thumbnail size'}" Style="{StaticResource Label}"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="ThumbSlider" Minimum="72" Maximum="200" TickFrequency="8"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ThumbSlider, StringFormat={}{0:0} px}"
                       Style="{StaticResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8"/>
        </Grid>

        <!-- Jogo -->
        <TextBlock Text="{s:Tr Pt='Jogo', En='Game'}" Style="{StaticResource Section}"/>
        <TextBlock x:Name="GamePathText" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <WrapPanel>
            <Button Content="{s:Tr Pt='Trocar pasta do jogo…', En='Change game folder…'}" Click="ChangeFolder_Click"/>
            <Button Content="{s:Tr Pt='Limpar cache e reescanear', En='Clear cache and rescan'}" Click="Rescan_Click"/>
            <Button Content="{s:Tr Pt='Abrir pasta de dados', En='Open data folder'}" Click="OpenData_Click"/>
        </WrapPanel>

        <!-- Sobre -->
        <TextBlock Text="{s:Tr Pt='Sobre', En='About'}" Style="{StaticResource Section}"/>
        <TextBlock x:Name="AboutText" Style="{StaticResource Dim}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{s:Tr Pt='Cancelar', En='Cancel'}" IsCancel="True"/>
            <Button Content="{s:Tr Pt='Salvar', En='Save'}" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" Margin="0,0,0,6"/>
        </StackPanel>
    </StackPanel>
</Window>
